# Claude Code state — track team-wide settings.json (permissions, hooks,
# plugin config) at any depth, but keep machine-local files (*.local.json)
# and anything else under .claude/ that we haven't whitelisted ignored.
# Leading **/ makes the rule match nested .claude/ folders too.
**/.claude/*
!**/.claude/settings.json

# Common OS / editor cruft
Thumbs.db
.DS_Store
*.swp
.vscode/

# Python build artifacts
__pycache__/
*.pyc

# Office temp lockfiles
~$*

# Office timestamped + rolling backups (kept locally per the backup
# convention, but never committed) and in-place build temp files
*_backup_*.pptx
*_backup_*.docx
*_t-1.*
*_t-2.*
*.pptx.tmp

# Render / probe output and side-path test builds
_probe/
*_test.pptx
# Regenerable analysis dumps (diff reports and deck text extracts) - the
# scripts that produce them are tracked, the output is not
_diff_*.txt
_deck_content.md
